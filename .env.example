# MyFinances — environment variables
#
# This file documents available env vars. The automated setup (setup.sh /
# setup.ps1) handles these for you. If you are configuring manually (e.g.
# Portainer's "Environment variables" UI or a bare docker run), set these
# values in your deployment tool.
#
# Since 8.0.0 the passwords are variables here, not Docker secret files: this
# file holds credentials, so keep it private (chmod 600 .env) and out of git.
# Single-quote values with $, # or spaces (a value containing a single quote
# must be set outside .env).

# Database password (required). Postgres applies it only when its data volume
# is first created; to change it later, see DEPLOYMENT.md, "Changing the
# database password". The server builds DATABASE_URL from it at startup.
POSTGRES_PASSWORD=

# How long a login session stays valid (days). Default: 7.
SESSION_TTL_DAYS=7

# NODE_ENV is not used to gate cookie security anymore (see server/src/app.js's
# `trust proxy` + server/src/routes/auth.js's per-request `req.secure`): the
# session/csrf cookies' Secure flag is now derived from whether the request
# actually arrived over HTTPS (via nginx's X-Forwarded-Proto), correct in both
# local plain-HTTP testing and a real HTTPS deployment with no manual step or
# sequencing gap either way.

# SMTP email sending (optional). Leave SMTP_HOST unset to disable email
# notifications entirely -- nothing else in this list matters until it's
# set. setup.sh/setup.ps1 configure all of this interactively; see
# server/README.md's "Email notifications" section for the manual/Portainer
# path. Since 8.0.0 the password is SMTP_PASSWORD (secrets/smtp_password.txt
# is no longer read). Single-quote it so $, # and spaces are kept literally
# (a password containing a single quote must be set outside .env). Keep this
# file private (chmod 600): it now holds a credential.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Optional self-hosted Google Analytics (#131). Leave unset (the default) to
# keep analytics off entirely -- nothing is loaded or contacted. Set to your
# own GA4 measurement id to opt this instance in; a container-startup script
# writes it into env-config.js, which the frontend reads before deciding
# whether to load gtag.js. See DEPLOYMENT.md's "Google Analytics (Optional)"
# section.
GA_MEASUREMENT_ID=

# How long (whole seconds) a browser tab must be hidden before it re-reads
# the server when you come back to it, so edits made on another device show up
# (#575). Leave unset for the default of 60. 0 refreshes on every return.
# Tabs in the same browser update within about a second regardless.
REFRESH_ON_FOCUS_SECONDS=

# Server background jobs (#579): the monthly net-worth snapshot (only for
# users who turned on "Auto-capture monthly net worth snapshot" in Settings)
# and hourly pruning of expired sign-in sessions. On by default; set to false
# to turn every job off. TZ sets the server's time zone, which decides when a
# month (or hour) starts for the jobs, and the time zone the backup service
# reads BACKUP_SCHEDULE in (e.g. America/Chicago). Default: UTC.
JOBS_ENABLED=true
TZ=UTC

# Nightly pg_dump into the backup-data volume (server/README.md, #656).
# Standard 5-field cron, in TZ above. Default: 2 am daily, 7 days kept.
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=7

# Reverse proxies in front of the server (Express `trust proxy`). 1 = only the
# bundled nginx (default). Behind another reverse proxy (Traefik, Nginx Proxy
# Manager, Caddy, Cloudflare Tunnel, ...) set 2: otherwise the server sees that
# proxy's address for every visitor, so all devices share one login rate limit
# (5 failed sign-ins per 15 minutes). Never set it higher than the real number
# of proxies: an extra hop lets a client forge its address.
TRUST_PROXY_HOPS=1
